---
import type { CollectionEntry } from "astro:content";
import { SITE } from "@/config";
import { Image } from 'astro:assets';

export interface Props extends CollectionEntry<"companies">{
    index: number;
    numberOfSubsidiaries: number;
    orbit: number;
    parentCompany: string;
};

const { data, index, orbit, numberOfSubsidiaries, parentCompany } = Astro.props;
const { id, name, description, location } = data;

// Calculate animation delay based on index and number of subsidiaries in the same orbit
const delayValueZone1 = (index * SITE.orbit1RevolveTime ) / (numberOfSubsidiaries);
const delayValueZone2 = (index * SITE.orbit2RevolveTime ) / (numberOfSubsidiaries);
const delayValueZone3 = (index * SITE.orbit3RevolveTime ) / (numberOfSubsidiaries);

---

{(orbit === 1) &&
        <div class={`subsidiary align-middle  content-center zone-1 size-[100px] bg-${parentCompany}`} data-name={id} style={`animation-delay: -${delayValueZone1}s;`}>
                <img class="inline-block align-middle" src={`src/assets/logos/${parentCompany}/${id}.png`} alt={id} width="100" height="100" />
        </div>
}
{(orbit === 2) &&
        <div class={`subsidiary zone-2 bg-${parentCompany}`} data-name={id} style={`animation-delay: -${delayValueZone2}s;`}>{name}</div>
}
{(orbit === 3) &&
        <div class={`subsidiary zone-3 bg-${parentCompany}`}  data-name={id} style={`animation-delay: -${delayValueZone3}s;`}>{name}</div>
}