---
import type { CollectionEntry } from "astro:content";

export interface Props extends CollectionEntry<"companies">{
    index: number;
    numberOfSubsidiaries: number;
    orbit: number;
    parentCompany: string;
};

const { data, index, orbit, parentCompany } = Astro.props;
const { id, name } = data;

---

<div class={`subsidiary subsidiary-zone-${orbit}`} data-name={id}>
	<img
		class="subsidiary-logo"
		src={`src/assets/logos/${parentCompany}/${id}.png`}
		alt={name}
		width="80"
		height="80"
	/>
	<span class="subsidiary-name">{name}</span>
</div>
