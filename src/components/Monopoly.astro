---
import type { CollectionEntry } from "astro:content";
import { getCollection } from "astro:content";
import Subsidiary from "../components/Subsidiary.astro";

export interface Props extends CollectionEntry<"companies">{};
const { data } = Astro.props;
const { id, name, description, location } = data;

const subsidiaries = (await getCollection('companies', ({ data }) => {
  return data.parent == id;
}));

const zone1Subs = subsidiaries.filter(s => s.data.influence_zone === 1);
const zone2Subs = subsidiaries.filter(s => s.data.influence_zone === 2);
const zone3Subs = subsidiaries.filter(s => s.data.influence_zone === 3);

---
<div class="monopoly-wrapper w-full">
	<section class={`monopoly-header bg-${id} text-center uppercase p-10 pb-20 w-full`}>
		<h2>{name}</h2>
	</section>
	<section class={`monopoly-container bg-${id} w-full`}>
	<div class="zone zone-1">
		<div class="zone-content">
			{zone1Subs.map((subsidiary, index) =>
				<Subsidiary
					{...subsidiary}
					index={index}
					numberOfSubsidiaries={zone1Subs.length}
					orbit={1}
					parentCompany={id}
				/>
			)}
		</div>
	</div>

	<div class="zone zone-2 zone-top-curved">
		<div class="zone-content">
			{zone2Subs.map((subsidiary, index) =>
				<Subsidiary
					{...subsidiary}
					index={index}
					numberOfSubsidiaries={zone2Subs.length}
					orbit={2}
					parentCompany={id}
				/>
			)}
		</div>
	</div>

	<div class="zone zone-3 zone-top-curved">
		<div class="zone-content">
			{zone3Subs.map((subsidiary, index) =>
				<Subsidiary
					{...subsidiary}
					index={index}
					numberOfSubsidiaries={zone3Subs.length}
					orbit={3}
					parentCompany={id}
				/>
			)}
		</div>
	</div>
	<div class="bg-black m-30 italic">
		...Back to traveling the monopoly-space...<br/>
		<br/>
		...What is the nexy destination going to be?...
	</div>
</section>
</div>
