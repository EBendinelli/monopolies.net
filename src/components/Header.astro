---
import { SITE } from "@/config";
import { Image } from "astro:assets";
import logo from '../assets/network.svg';
import { getCollection } from "astro:content";
import Monopoly from '../components/Monopoly.astro';

const bigTech = (await getCollection('companies', ({ data }) => {
  return data.big_tech;
}));

---

<div id="container">
	<main>
		<section id="hero" class="text-white grid h-screen text-center place-content-center bg-black">
			<div class=""></div>
			<!-- <div class="star-field">
				<div class="layer"></div>
				<div class="layer"></div>
				<div class="layer"></div>
			</div> -->
			<div class="header-content max-w-3xl mx-auto px-4 ">
				<Image src={logo} alt="Monopolies.net Logo" class="inline"/>
				<h1>
					{ SITE.title }
				</h1>
				<section id="home-description" class="text-xl">
					Welcome corporate space aventurer! Let's explore the vast galaxies of influence of tech giants 
					in a space trip you that will make you discover things you never imagined about your favorite companies.
				</section>
			</div>
				<nav class="monopoly-nav">
					{bigTech.map(monopoly => (
						<a class="monopoly-link"
							href={`#${monopoly.data.id}`}
							aria-label={`Jump to ${monopoly.data.name}`}
							style={`text-shadow: 0 2px 8px var(--${monopoly.data.id}, var(--color-accent));`}>
							{monopoly.data.name}
						</a>
					))}
				</nav>
		</section>
	</main>

</div>